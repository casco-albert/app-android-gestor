<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <!-- FILA SUPERIOR: Spinner + Totales -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#E8F5E9">

        <!-- Spinner -->
        <Spinner
            android:id="@+id/spinnerCargas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:spinnerMode="dropdown"/>

        <!-- Totales -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp">

            <!-- Total Cantidad -->
            <TextView
                android:id="@+id/txtTotalCantidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T.Cant.: 0"
                android:textStyle="bold"
                android:textSize="14sp"
                android:paddingEnd="12dp"/>

            <!-- Total Kilos -->
            <TextView
                android:id="@+id/txtTotalKilos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kg: 0"
                android:textStyle="bold"
                android:textSize="14sp"/>

        </LinearLayout>

    </LinearLayout>
    <!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#DDDDDD"
        android:padding="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Nro -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:gravity="center"
            android:text="Nro"
            android:textStyle="bold"
            android:textSize="12sp"/>

        <!-- Cliente -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:gravity="start"
            android:text="Cliente"
            android:textStyle="bold"
            android:textSize="12sp"/>

        <!-- Cantidad -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:gravity="start"
            android:text="Cant."
            android:textStyle="bold"
            android:textSize="12sp"/>

        <!-- Kg -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:gravity="end"
            android:text="Kg"
            android:textStyle="bold"
            android:textSize="12sp"/>

        <!-- Total -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:gravity="end"
            android:text="Total"
            android:textStyle="bold"
            android:textSize="12sp"/>
        <!-- Acciones -->
        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Ent."
                android:textStyle="bold"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Edit"
                android:textStyle="bold"
                android:textSize="12sp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- LISTA -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPedidos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- BOTONES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:padding="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnCSV"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/csv"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Exportar CSV"/>

        <ImageButton
            android:id="@+id/btnPDF"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/pdf"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Exportar PDF"/>

    </LinearLayout>

</LinearLayout>