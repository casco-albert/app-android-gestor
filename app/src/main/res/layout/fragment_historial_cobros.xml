<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Contenido principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_above="@id/layoutBotones">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Historial Resumida de Cobros"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>
        <!-- Filtros -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <!-- Spinner arriba -->
            <Spinner
                android:id="@+id/spClientes"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:textSize="18sp"
                android:spinnerMode="dropdown"
                android:layout_marginBottom="6dp"/>

            <!-- Fechas lado a lado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etFechaIni"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="Desde"
                    android:focusable="false"
                    android:clickable="true"
                    android:background="@android:drawable/editbox_background"
                    android:padding="6dp"
                    android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                    android:drawablePadding="6dp"/>

                <EditText
                    android:id="@+id/etFechaFin"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="Hasta"
                    android:focusable="false"
                    android:clickable="true"
                    android:background="@android:drawable/editbox_background"
                    android:padding="6dp"
                    android:layout_marginStart="6dp"
                    android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                    android:drawablePadding="6dp"/>
            </LinearLayout>

        </LinearLayout>
        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="#EEEEEE">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:text="Cliente/Fecha"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Monto"
                android:textStyle="bold"
                android:gravity="end"/>

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Deuda"
                android:textStyle="bold"
                android:gravity="end"/>
        </LinearLayout>

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistorialCobros"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="4dp"/>
    </LinearLayout>

    <!-- Botones abajo derecha -->
    <LinearLayout
        android:id="@+id/layoutBotones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="end"
        android:padding="12dp"
        android:orientation="horizontal">


        <ImageButton
            android:id="@+id/btnExportPDF"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/pdf"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <ImageButton
            android:id="@+id/btnExportExcel"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/csv"
            android:scaleType="centerInside"
            android:padding="10dp" android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

</RelativeLayout>